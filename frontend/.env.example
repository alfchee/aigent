# API base URL (defaults to window.location.origin when not set)
# VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL (defaults to ws[s]://host/ws/{sessionId})
# VITE_WS_URL=ws://localhost:8000/ws

# Set to 'true' when the backend has AIGENT_API_KEY configured.
# When enabled, the app will prompt for the API key on first load.
# VITE_AUTH_ENABLED=true
